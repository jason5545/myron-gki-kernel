# 來源：linux-6.12.y stable（LunaKernel r21 也採用） 1c206d461c68（upstream 0e243671bc7b，6.12.104）
# ipv6: prevent in6_dev_get() from resurrecting inet6_dev
# IPv6 路徑上可從網路觸發的 UAF／NULL／越界（LunaKernel 已採用）
diff --git a/include/net/addrconf.h b/include/net/addrconf.h
index bdd3374842..a44ab67c9c 100644
--- a/include/net/addrconf.h
+++ b/include/net/addrconf.h
@@ -389,8 +389,8 @@ static inline struct inet6_dev *in6_dev_get(const struct net_device *dev)
 
 	rcu_read_lock();
 	idev = rcu_dereference(dev->ip6_ptr);
-	if (idev)
-		refcount_inc(&idev->refcnt);
+	if (idev && !refcount_inc_not_zero(&idev->refcnt))
+		idev = NULL;
 	rcu_read_unlock();
 	return idev;
 }
