# 來源：linux-6.12.y stable 3e3394a13b60（upstream 8e759cd1f644，6.12.112）
# tcp: Don't call skb_clone_and_charge_r() for close()d listener in tcp_v6_do_rcv().
# IPv6 listener 被 close() 時，tcp_v6_do_rcv() 在沒有鎖的情況下計入 sk_forward_alloc，記憶體計數錯誤
diff --git a/net/ipv6/tcp_ipv6.c b/net/ipv6/tcp_ipv6.c
index 1daee81b6a..7400179ef8 100644
--- a/net/ipv6/tcp_ipv6.c
+++ b/net/ipv6/tcp_ipv6.c
@@ -1621,7 +1621,8 @@ int tcp_v6_do_rcv(struct sock *sk, struct sk_buff *skb)
 	   by tcp. Feel free to propose better solution.
 					       --ANK (980728)
 	 */
-	if (np->rxopt.all && sk->sk_state != TCP_LISTEN)
+	if (np->rxopt.all &&
+	    !((1 << sk->sk_state) & (TCPF_LISTEN | TCPF_CLOSE)))
 		opt_skb = skb_clone_and_charge_r(skb, sk);
 
 	if (sk->sk_state == TCP_ESTABLISHED) { /* Fast path */
