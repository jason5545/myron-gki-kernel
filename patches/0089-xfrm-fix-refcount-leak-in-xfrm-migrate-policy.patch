# xfrm: fix refcount leak in xfrm_migrate_policy_find
# xfrm 介面註銷時清除、MIGRATE 參考計數、刪除時解 hash、state_ptrs 初始化、xfrm6 saddr
diff --git a/net/xfrm/xfrm_policy.c b/net/xfrm/xfrm_policy.c
index 8e358fa812..14c8ef593b 100644
--- a/net/xfrm/xfrm_policy.c
+++ b/net/xfrm/xfrm_policy.c
@@ -4505,9 +4505,6 @@ static struct xfrm_policy *xfrm_migrate_policy_find(const struct xfrm_selector *
 	pol = xfrm_policy_lookup_bytype(net, type, &fl, sel->family, dir, if_id);
 	if (IS_ERR_OR_NULL(pol))
 		goto out_unlock;
