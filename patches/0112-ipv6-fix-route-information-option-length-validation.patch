# 來源：linux-6.12.y stable（LunaKernel r21 也採用） ff3cb05289b8（upstream d1ad8fb2ac6a，6.12.104）
# ipv6: fix Route Information option length validation
# IPv6 路徑上可從網路觸發的 UAF／NULL／越界（LunaKernel 已採用）
diff --git a/net/ipv6/route.c b/net/ipv6/route.c
index 9015d36f2b..70c54e1f90 100644
--- a/net/ipv6/route.c
+++ b/net/ipv6/route.c
@@ -985,13 +985,13 @@ int rt6_route_rcv(struct net_device *dev, u8 *opt, int len,
 	} else if (rinfo->prefix_len > 128) {
 		return -EINVAL;
 	} else if (rinfo->prefix_len > 64) {
-		if (rinfo->length < 2) {
+		/* RFC 4191: Length MUST be 3 when Prefix Length > 64 */
+		if (rinfo->length < 3)
 			return -EINVAL;
-		}
 	} else if (rinfo->prefix_len > 0) {
-		if (rinfo->length < 1) {
+		/* RFC 4191: Length MUST be 2 or 3 when Prefix Length > 0 */
+		if (rinfo->length < 2)
 			return -EINVAL;
-		}
 	}
 
 	pref = rinfo->route_pref;
