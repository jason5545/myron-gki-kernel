diff --git a/fs/fuse/dev.c b/fs/fuse/dev.c
index 9cf2561fba..3eb93b9d6f 100644
--- a/fs/fuse/dev.c
+++ b/fs/fuse/dev.c
@@ -971,7 +971,7 @@ static int fuse_ref_page(struct fuse_copy_state *cs, struct page *page,
 	cs->nr_segs++;
 	cs->len = 0;
 
-	return 0;
+	return lock_request(cs->req);
 }
 
