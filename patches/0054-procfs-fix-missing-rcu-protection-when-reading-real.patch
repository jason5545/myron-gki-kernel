# 來源：linux-6.12.y stable 73ec7c96601d（upstream 76149d53502c，6.12.75）
# procfs: fix missing RCU protection when reading real_parent in do_task_stat()
# do_task_stat() 讀 real_parent 缺 RCU
diff --git a/fs/proc/array.c b/fs/proc/array.c
index 5e4f7b411f..363d933121 100644
--- a/fs/proc/array.c
+++ b/fs/proc/array.c
@@ -531,7 +531,7 @@ static int do_task_stat(struct seq_file *m, struct pid_namespace *ns,
 		}
 
 		sid = task_session_nr_ns(task, ns);
-		ppid = task_tgid_nr_ns(task->real_parent, ns);
+		ppid = task_ppid_nr_ns(task, ns);
 		pgid = task_pgrp_nr_ns(task, ns);
 
 		unlock_task_sighand(task, &flags);
