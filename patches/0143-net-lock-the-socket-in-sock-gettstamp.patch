# 來源：linux-6.12.y stable 1f73253add83（upstream 9ed55f3dbef4，6.12.112）
# net: lock the socket in sock_gettstamp()
# SIOCGSTAMP 與 bind() 同時改 sk_flags，會清掉 SOCK_RCU_FREE，造成 UDP socket UAF；一般 app 可觸發
diff --git a/net/core/sock.c b/net/core/sock.c
index 6b5c84bc23..7750a87115 100644
--- a/net/core/sock.c
+++ b/net/core/sock.c
@@ -3708,7 +3708,14 @@ int sock_gettstamp(struct socket *sock, void __user *userstamp,
 	struct sock *sk = sock->sk;
 	struct timespec64 ts;
 
-	sock_enable_timestamp(sk, SOCK_TIMESTAMP);
+	/* sk->sk_flags must only be changed under the socket lock,
+	 * because sock_set_flag() uses non atomic operations.
+	 */
+	if (!sock_flag(sk, SOCK_TIMESTAMP)) {
+		lock_sock(sk);
+		sock_enable_timestamp(sk, SOCK_TIMESTAMP);
+		release_sock(sk);
+	}
 	ts = ktime_to_timespec64(sock_read_timestamp(sk));
 	if (ts.tv_sec == -1)
 		return -ENOENT;
