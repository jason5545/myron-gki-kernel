# 來源：linux-6.12.y stable 7be222de96c0（upstream 2d9c4a4ed4ee，6.12.86）
# f2fs: fix UAF caused by decrementing sbi->nr_pages[] in f2fs_write_end_io()
# f2fs_write_end_io() 遞減 nr_pages 後 umount 把 node_inode 設成 NULL，f2fs_in_warm_node_list() 會 NULL deref
# 改寫：stable 版是 page 介面；改用 LunaKernel r21 的 folio 版（patches/backports/f2fs-write-end-io-uaf-r21.patch），在上一份 patch 之後可直接套用
diff --git a/fs/f2fs/data.c b/fs/f2fs/data.c
index 3efd10e715..d3d8662f15 100644
--- a/fs/f2fs/data.c
+++ b/fs/f2fs/data.c
@@ -361,6 +361,8 @@ static void f2fs_write_end_io(struct bio *bio)
 
 		f2fs_bug_on(sbi, folio->mapping == NODE_MAPPING(sbi) &&
 				folio->index != nid_of_node(&folio->page));
+		if (f2fs_in_warm_node_list(sbi, folio))
+			f2fs_del_fsync_node_entry(sbi, &folio->page);
 
 		dec_page_count(sbi, type);
 
@@ -372,8 +374,6 @@ static void f2fs_write_end_io(struct bio *bio)
 				wq_has_sleeper(&sbi->cp_wait))
 			wake_up(&sbi->cp_wait);
 
-		if (f2fs_in_warm_node_list(sbi, folio))
-			f2fs_del_fsync_node_entry(sbi, &folio->page);
 		clear_page_private_gcing(&folio->page);
 		folio_end_writeback(folio);
 	}
