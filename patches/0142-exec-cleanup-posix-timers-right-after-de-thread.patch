# 來源：linux-6.12.y stable d9ae467e617c（upstream acb03d388181，6.12.112）
# exec: Cleanup POSIX timers right after de_thread()
# 多執行緒 exec 在 de_thread() 之後失敗時，POSIX CPU timer 留在佇列裡被釋放，造成 UAF；一般 app 可觸發
# 以 3-way 合併套到 v16.1，內容與原 commit 相同，只有上下文不同
diff --git a/fs/exec.c b/fs/exec.c
index 7189d45e54..30829a8d85 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1224,6 +1224,17 @@ void __set_task_comm(struct task_struct *tsk, const char *buf, bool exec)
 }
 EXPORT_SYMBOL_GPL(__set_task_comm);
 
+static void posixtimer_exec(struct task_struct *me)
+{
+#ifdef CONFIG_POSIX_TIMERS
+	spin_lock_irq(&me->sighand->siglock);
+	posix_cpu_timers_exit(me);
+	spin_unlock_irq(&me->sighand->siglock);
+	exit_itimers(me);
+	flush_itimer_signals();
+#endif
+}
+
 /*
  * Calling this is the point of no return. None of the failures will be
  * seen by userspace since either the process is already taking a fatal
@@ -1257,6 +1268,16 @@ int begin_new_exec(struct linux_binprm * bprm)
 	retval = de_thread(me);
 	if (retval)
 		goto out;
+
+	/*
+	 * This must be done here to ensure that POSIX CPU timers which were
+	 * armed on the current task are dequeued from me::posix_cputimers.
+	 * Otherwise in case of a TID switch the deletion of the related POSIX
+	 * timer would not remove an enqueued timer because the TID lookup
+	 * of the old TID fails.
+	 */
+	posixtimer_exec(me);
+
 	/* see the comment in check_unsafe_exec() */
 	current->fs->in_exec = 0;
 	/*
@@ -1297,14 +1318,6 @@ int begin_new_exec(struct linux_binprm * bprm)
 	if (retval)
 		goto out_unlock;
 
-#ifdef CONFIG_POSIX_TIMERS
-	spin_lock_irq(&me->sighand->siglock);
-	posix_cpu_timers_exit(me);
-	spin_unlock_irq(&me->sighand->siglock);
-	exit_itimers(me);
-	flush_itimer_signals();
-#endif
-
 	/*
 	 * Make the signal table private.
 	 */
