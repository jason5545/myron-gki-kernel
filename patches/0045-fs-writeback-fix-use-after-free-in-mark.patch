# 來源：linux-6.12.y stable e63052921f1b（upstream d02d2c98d257，6.12.46）
# fs: writeback: fix use-after-free in __mark_inode_dirty()
# writeback __mark_inode_dirty() UAF
diff --git a/fs/fs-writeback.c b/fs/fs-writeback.c
index 4a1c588aaa..c78a5923ec 100644
--- a/fs/fs-writeback.c
+++ b/fs/fs-writeback.c
@@ -2582,10 +2582,6 @@ void __mark_inode_dirty(struct inode *inode, int flags)
 			wakeup_bdi = inode_io_list_move_locked(inode, wb,
 							       dirty_list);
 
-			spin_unlock(&wb->list_lock);
-			spin_unlock(&inode->i_lock);
-			trace_writeback_dirty_inode_enqueue(inode);
-
 			/*
 			 * If this is the first dirty inode for this bdi,
 			 * we have to wake-up the corresponding bdi thread
@@ -2595,6 +2591,11 @@ void __mark_inode_dirty(struct inode *inode, int flags)
 			if (wakeup_bdi &&
 			    (wb->bdi->capabilities & BDI_CAP_WRITEBACK))
 				wb_wakeup_delayed(wb);
+
+			spin_unlock(&wb->list_lock);
+			spin_unlock(&inode->i_lock);
+			trace_writeback_dirty_inode_enqueue(inode);
+
 			return;
 		}
 	}
