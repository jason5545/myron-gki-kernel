diff --git a/net/unix/af_unix.c b/net/unix/af_unix.c
index ecb2907d65..27898c06f5 100644
--- a/net/unix/af_unix.c
+++ b/net/unix/af_unix.c
@@ -3189,6 +3189,9 @@ static int unix_ioctl(struct socket *sock, unsigned int cmd, unsigned long arg)
 			struct sk_buff *skb;
