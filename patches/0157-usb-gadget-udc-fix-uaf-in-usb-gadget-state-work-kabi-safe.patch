# 來源：ACK android16-6.12 0aea479006df（upstream baeb66fbd420）＋ 7e73c6dc7aaf（KABI-safe 改寫），2026/10/7
# usb: gadget: udc: fix use-after-free in usb_gadget_state_work（KABI-safe）
# 修正：gadget 拆除時 state work 可能在釋放後才執行。upstream 版改到 KMI 型別 struct usb_gadget，10/2 被排除；ACK 改用 core.c 私有的 struct usb_udc 加全域 spinlock，兩筆合成一份淨 diff
# 改寫：基底沒有 FROMGIT 的 trace_usb_gadget_set_state()，從上下文拿掉；改動與 ACK 兩筆合併後相同
diff --git a/drivers/usb/gadget/udc/core.c b/drivers/usb/gadget/udc/core.c
index d709e24c1f..fd4809b741 100644
--- a/drivers/usb/gadget/udc/core.c
+++ b/drivers/usb/gadget/udc/core.c
@@ -28,6 +28,12 @@ static DEFINE_IDA(gadget_id_numbers);
 
 static const struct bus_type gadget_bus_type;
 
+/*
+ * ANDROID: Global lock used instead of a per-gadget lock to maintain KABI
+ * compatibility. Serializes state changes during gadget teardown.
+ */
+static DEFINE_SPINLOCK(android_udc_state_lock);
+
 /**
  * struct usb_udc - describes one usb device controller
  * @driver: the gadget driver pointer. For use by the class code
@@ -40,6 +46,8 @@ static const struct bus_type gadget_bus_type;
  * @allow_connect: Indicates whether UDC is allowed to be pulled up.
  * Set/cleared by gadget_(un)bind_driver() after gadget driver is bound or
  * unbound.
+ * @teardown: True if the device is undergoing teardown, used to prevent
+ * new work from being scheduled during cleanup.
  * @vbus_work: work routine to handle VBUS status change notifications.
  * @connect_lock: protects udc->started, gadget->connect,
  * gadget->allow_connect and gadget->deactivate. The routines
@@ -58,6 +66,7 @@ struct usb_udc {
 	bool				vbus;
 	bool				started;
 	bool				allow_connect;
+	bool				teardown;
 	struct work_struct		vbus_work;
 	struct mutex			connect_lock;
 };
@@ -1123,8 +1132,15 @@ static void usb_gadget_state_work(struct work_struct *work)
 void usb_gadget_set_state(struct usb_gadget *gadget,
 		enum usb_device_state state)
 {
+	struct usb_udc *udc;
+	unsigned long flags;
+
+	spin_lock_irqsave(&android_udc_state_lock, flags);
 	gadget->state = state;
-	schedule_work(&gadget->work);
+	udc = gadget->udc;
+	if (udc && !udc->teardown)
+		schedule_work(&gadget->work);
+	spin_unlock_irqrestore(&android_udc_state_lock, flags);
 }
 EXPORT_SYMBOL_GPL(usb_gadget_set_state);
 
@@ -1531,6 +1547,7 @@ EXPORT_SYMBOL_GPL(usb_add_gadget_udc);
 void usb_del_gadget(struct usb_gadget *gadget)
 {
 	struct usb_udc *udc = gadget->udc;
+	unsigned long flags;
 
 	if (!udc)
 		return;
@@ -1544,6 +1561,13 @@ void usb_del_gadget(struct usb_gadget *gadget)
 	kobject_uevent(&udc->dev.kobj, KOBJ_REMOVE);
 	sysfs_remove_link(&udc->dev.kobj, "gadget");
 	device_del(&gadget->dev);
+	/*
+	 * Set the teardown flag before flushing the work to prevent new work
+	 * from being scheduled while we are cleaning up.
+	 */
+	spin_lock_irqsave(&android_udc_state_lock, flags);
+	udc->teardown = true;
+	spin_unlock_irqrestore(&android_udc_state_lock, flags);
 	flush_work(&gadget->work);
 	ida_free(&gadget_id_numbers, gadget->id_number);
 	cancel_work_sync(&udc->vbus_work);
