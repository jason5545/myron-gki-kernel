# 來源：linux-6.12.y stable 4f244c64efe6（upstream 7c37c7951032，6.12.64）
# f2fs: fix to avoid updating zero-sized extent in extent cache
# extent cache 寫入零長度 extent
diff --git a/fs/f2fs/file.c b/fs/f2fs/file.c
index 950acbb468..54141c174d 100644
--- a/fs/f2fs/file.c
+++ b/fs/f2fs/file.c
@@ -1643,8 +1643,11 @@ static int f2fs_do_zero_range(struct dnode_of_data *dn, pgoff_t start,
 		f2fs_set_data_blkaddr(dn, NEW_ADDR);
 	}
 
-	f2fs_update_read_extent_cache_range(dn, start, 0, index - start);
-	f2fs_update_age_extent_cache_range(dn, start, index - start);
+	if (index > start) {
+		f2fs_update_read_extent_cache_range(dn, start, 0,
+							index - start);
+		f2fs_update_age_extent_cache_range(dn, start, index - start);
+	}
 
 	return ret;
 }
