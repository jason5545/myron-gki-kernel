# 來源：linux-6.12.y stable 5f06ee9f9a36（upstream 151c0aa896c4，6.12.42）
# usb: gadget : fix use-after-free in composite_dev_cleanup()
# composite_dev_cleanup() UAF
diff --git a/drivers/usb/gadget/composite.c b/drivers/usb/gadget/composite.c
index 2b86a7a21c..89f0beb9a0 100644
--- a/drivers/usb/gadget/composite.c
+++ b/drivers/usb/gadget/composite.c
@@ -2520,6 +2520,11 @@ int composite_os_desc_req_prepare(struct usb_composite_dev *cdev,
 	if (!cdev->os_desc_req->buf) {
 		ret = -ENOMEM;
 		usb_ep_free_request(ep0, cdev->os_desc_req);
+		/*
+		 * Set os_desc_req to NULL so that composite_dev_cleanup()
+		 * will not try to free it again.
+		 */
+		cdev->os_desc_req = NULL;
 		goto end;
 	}
 	cdev->os_desc_req->context = cdev;
